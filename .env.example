# Copy to .env and fill in. NEVER commit .env (it is in .gitignore/.dockerignore).
# Generate each secret with:  openssl rand -hex 24

# Two bootstrap credentials: on first start the container writes an identity file (digests only) with operator "admin" and agent "agent".
SENTINEL_BOOTSTRAP_ADMIN_TOKEN=
SENTINEL_BOOTSTRAP_AGENT_TOKEN=

# The exact origin you open the UI at (browsers are only accepted from here). Behind TLS: https://sentinel.example.com
SENTINEL_ALLOWED_ORIGINS=http://localhost:8080

# action_sim (meaning-based alerts, needs the baked-in model), rules, learned, registry modes: see docs/RUNNING.md
SENTINEL_MONITOR=action_sim

# Policy: builtin:starter (the default of this compose file) auto-allows plain read-only tools on ordinary paths and asks a human for
# everything else, including reads of .ssh, .env, credentials and similar. It allows only while a working monitor runs (not with
# EMBEDDINGS=0). To edit rules: python -m policy_cli init policy.json, mount the copy and set SENTINEL_POLICY to its path. See docs/policy.md.
# SENTINEL_POLICY=builtin:starter

# Tamper-evident event log (written to the data volume). Strongly recommended: a key of >= 16 characters.
SENTINEL_LOG_KEY=

# Behind a load balancer: its address range, so the sign-in throttle sees real client addresses (never * on an open network)
FORWARDED_ALLOW_IPS=127.0.0.1
