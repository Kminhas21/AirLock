{"version": 1, "default": "ask", "rules": [
 {"id": "allow-read-only-fs", "verdict": "allow",
  "note": "read-only filesystem tools on a string path (sensitive paths are asked below)",
  "when": {"tool": ["read_file", "read_text_file", "list_directory", "list_directory_with_sizes", "directory_tree", "search_files", "get_file_info"], "args": [{"path": "path", "op": "glob", "value": "*"}]}},
 {"id": "allow-read-multiple", "verdict": "allow",
  "note": "read_multiple_files (one sensitive path in the list is asked below)",
  "when": {"tool": "read_multiple_files", "args": [{"path": "paths", "op": "exists"}]}},
 {"id": "allow-read-only-other", "verdict": "allow",
  "note": "read-only tools without a file path: allowed directories, memory graph reads, time",
  "when": {"tool": ["list_allowed_directories", "read_graph", "search_nodes", "open_nodes", "get_current_time", "convert_time"]}},
 {"id": "ask-sensitive-path", "verdict": "ask",
  "note": "'path' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "path", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-paths", "verdict": "ask",
  "note": "'paths' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "paths", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-source", "verdict": "ask",
  "note": "'source' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "source", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-destination", "verdict": "ask",
  "note": "'destination' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "destination", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-directory", "verdict": "ask",
  "note": "'directory' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "directory", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-file", "verdict": "ask",
  "note": "'file' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "file", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-url-flag", "verdict": "ask",
  "note": "isUrl is set: the tool is asked to fetch a URL (flag spelled isUrl only; other spellings are covered by the :// needle)",
  "when": {"args": [{"path": "isUrl", "op": "in", "value": [true, "true", "True", "TRUE", 1]}]}}
]}
