{"version": 1, "default": "ask", "rules": [
 {"id": "allow-read-file", "verdict": "allow",
  "note": "read a file on a string path, with the real tools' own arguments only (filesystem: head, tail; Desktop Commander: offset, length)",
  "when": {"tool": ["read_file", "read_text_file"], "arg_keys": ["path", "head", "tail", "offset", "length"], "args": [{"path": "path", "op": "glob", "value": "*"}]}, "confine": {"path": "read"}},
 {"id": "allow-read-only-fs", "verdict": "allow",
  "note": "list a directory / file metadata on a string path (names, not contents)",
  "when": {"tool": ["list_directory", "get_file_info"], "arg_keys": ["path"], "args": [{"path": "path", "op": "glob", "value": "*"}]}, "confine": {"path": "list"}},
 {"id": "allow-list-sizes", "verdict": "allow",
  "when": {"tool": "list_directory_with_sizes", "arg_keys": ["path", "sortBy"], "args": [{"path": "path", "op": "glob", "value": "*"}]}, "confine": {"path": "list"}},
 {"id": "allow-tree", "verdict": "allow",
  "when": {"tool": "directory_tree", "arg_keys": ["path", "excludePatterns"], "args": [{"path": "path", "op": "glob", "value": "*"}]}, "confine": {"path": "list"}},
 {"id": "allow-search", "verdict": "allow",
  "when": {"tool": "search_files", "arg_keys": ["path", "pattern", "excludePatterns"], "args": [{"path": "path", "op": "glob", "value": "*"}]}, "confine": {"path": "list"}},
 {"id": "allow-read-multiple", "verdict": "allow",
  "note": "read_multiple_files on a non-empty list (one sensitive path in the list is asked below)",
  "when": {"tool": "read_multiple_files", "arg_keys": ["paths"], "args": [{"path": "paths.0", "op": "exists"}]}, "confine": {"paths": "read"}},
 {"id": "allow-read-only-other", "verdict": "allow",
  "note": "allowed directories, the whole memory graph: no arguments",
  "when": {"tool": ["list_allowed_directories", "read_graph"], "arg_keys": []}, "confine": {}},
 {"id": "allow-memory-search", "verdict": "allow", "when": {"tool": "search_nodes", "arg_keys": ["query"]}, "confine": {}},
 {"id": "allow-memory-open", "verdict": "allow", "when": {"tool": "open_nodes", "arg_keys": ["names"]}, "confine": {}},
 {"id": "allow-time-now", "verdict": "allow", "when": {"tool": "get_current_time", "arg_keys": ["timezone"]}, "confine": {}},
 {"id": "allow-time-convert", "verdict": "allow", "when": {"tool": "convert_time", "arg_keys": ["source_timezone", "target_timezone", "time"]}, "confine": {}},
 {"id": "allow-write-docs", "verdict": "allow",
  "note": "OVERWRITE an existing .md .txt .rst .csv .log file: one inode, kernel-confined, before-image kept (D32). Creating, moving, code: asked",
  "when": {"tool": "write_file", "arg_keys": ["path", "content"], "args": [{"path": "path", "op": "glob", "value": ["*.md", "*.txt", "*.rst", "*.csv", "*.log"]}, {"path": "content", "op": "glob", "value": "*"}, {"path": "content", "op": "max_len", "value": 20000}]}, "confine": {"path": "write"}},
 {"id": "allow-edit-docs", "verdict": "allow",
  "note": "edit an existing .md .txt .rst .csv .log file in place (at most 50 edits): same one-inode grant and before-image",
  "when": {"tool": "edit_file", "arg_keys": ["path", "edits", "dryRun"], "args": [{"path": "path", "op": "glob", "value": ["*.md", "*.txt", "*.rst", "*.csv", "*.log"]}, {"path": "edits.0", "op": "exists"}, {"path": "edits", "op": "max_len", "value": 50}]}, "confine": {"path": "write"}},
 {"id": "ask-sensitive-path", "verdict": "ask",
  "note": "'path' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "path", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-paths", "verdict": "ask",
  "note": "'paths' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "paths", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-source", "verdict": "ask",
  "note": "'source' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "source", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-destination", "verdict": "ask",
  "note": "'destination' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "destination", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-directory", "verdict": "ask",
  "note": "'directory' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "directory", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-file", "verdict": "ask",
  "note": "'file' names a credential, key or config location, or is a URL (a fetch leaves the machine): a human decides",
  "when": {"args": [{"path": "file", "op": "icontains_any", "value": [".ssh", ".aws", ".gnupg", ".env", "id_rsa", "id_ed25519", "credentials", "secrets", ".netrc", "/etc/shadow", "/etc/passwd", ".kube", ".git/config", "id_ecdsa", "id_dsa", ".pgpass", ".npmrc", ".docker", ".pem", ".p12", ".pfx", "/proc/", "sudoers", ".bash_history", ".git-credentials", "://"]}]}},
 {"id": "ask-sensitive-write-path", "verdict": "ask",
  "note": "a write to something later RUN or obeyed (hooks, CI, rc files, agent instructions, keys, .env): a human decides",
  "when": {"tool": ["write_file", "edit_file"], "args": [{"path": "path", "op": "icontains_any", "value": [".git/", ".github/", ".gitlab-ci", ".circleci", "jenkinsfile", ".husky", ".vscode", ".claude", ".cursor", "claude.md", "agents.md", "gemini.md", "copilot-instructions", ".bashrc", ".zshrc", ".profile", ".bash_profile", ".zprofile", ".envrc", "authorized_keys", "crontab", ".ssh", ".env", "requirements", "constraints", "cmakelists", "skill.md", "agent.md", "conventions.md", ".windsurf", ".clinerules", ".roo", ".continue", ".aider"]}]}},
 {"id": "ask-url-flag", "verdict": "ask",
  "note": "isUrl is set: a URL fetch (no allow rule lists isUrl, so this only matters in a copy that widens arg_keys or the default)",
  "when": {"args": [{"path": "isUrl", "op": "in", "value": [true, "true", "True", "TRUE", 1]}]}}
]}
